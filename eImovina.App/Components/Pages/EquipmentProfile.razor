@page "/equipment/{Id:int}"
@attribute [Authorize(Roles = "Admin,InventoryManager,LocationResponsible")]
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@using eImovina.Shared.DTOs
@using eImovina.Shared.DTOs.Equipments
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (profile is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@profile.Equipment.Name</MudText>
        <MudChip T="string" Color="@GetStatusColor(profile.Equipment.Status)" Size="Size.Large">
            @profile.Equipment.Status
        </MudChip>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Inventurni broj</MudText>
                <MudText Class="mb-2">@profile.Equipment.InventoryNumber</MudText>

                <MudText Typo="Typo.subtitle2">Serijski broj</MudText>
                <MudText Class="mb-2">@(profile.Equipment.SerialNumber ?? "-")</MudText>

                <MudText Typo="Typo.subtitle2">Kategorija</MudText>
                <MudText Class="mb-2">@profile.Equipment.Category</MudText>

                <MudText Typo="Typo.subtitle2">Lokacija</MudText>
                <MudText Class="mb-2">@profile.Equipment.CurrentLocation</MudText>

                <MudText Typo="Typo.subtitle2">Trenutačno zaduženo na</MudText>
                <MudText Class="mb-2">@(profile.Equipment.AssignedTo ?? "Nije zaduženo")</MudText>

                <MudDivider Class="my-3" />

                @if (profile.Equipment.Status == "Otpisano")
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Otpisana oprema se ne može zadužiti.
                    </MudAlert>
                }
                else if (profile.Equipment.AssignedToEmployeeId is null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="OpenAssignDialog">
                        Zaduži
                    </MudButton>
                }
                else
                {
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="OpenTransferDialog">
                            Prenesi drugom zaposleniku
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true" OnClick="ReturnEquipment">
                            Zaprimi povrat
                        </MudButton>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudTabs Elevation="1" Rounded="true">
                <MudTabPanel Text="Povijest zaduženja">
                    <MudTable Items="@profile.AssignmentHistory" Hover="true" Dense="true" Class="mt-2">
                        <HeaderContent>
                            <MudTh>Zaposlenik</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Zaduženo</MudTh>
                            <MudTh>Vraćeno</MudTh>
                            <MudTh>Zadužio</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Zaposlenik">@context.Employee</MudTd>
                            <MudTd DataLabel="Status">@context.Status</MudTd>
                            <MudTd DataLabel="Zaduženo">@context.AssignedAt.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Vraćeno">@(context.ReturnedAt?.ToShortDateString() ?? "-")</MudTd>
                            <MudTd DataLabel="Zadužio">@context.AssignedBy</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Class="pa-4">Oprema još nije bila zaduživana.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="Datoteke">
                    <MudPaper Class="pa-4 mt-2 mb-4">
                        <MudText Typo="Typo.subtitle1" GutterBottom="true">Dodaj sliku ili dokument</MudText>

                        @if (!string.IsNullOrWhiteSpace(uploadError))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@uploadError</MudAlert>
                        }

                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="Tip datoteke" @bind-Value="uploadFileType" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("Image")">Slika</MudSelectItem>
                                    <MudSelectItem Value="@("Invoice")">Račun</MudSelectItem>
                                    <MudSelectItem Value="@("Warranty")">Jamstvo</MudSelectItem>
                                    <MudSelectItem Value="@("ServiceDoc")">Servisna dokumentacija</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".jpg,.jpeg,.png,.webp,.pdf">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.AttachFile"
                                                   FullWidth="true">
                                            @(selectedFile is null ? "Odaberi datoteku" : selectedFile.Name)
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            </MudItem>
                            <MudItem xs="12" md="2" Class="d-flex align-center">
                                @if (uploadFileType == "Image")
                                {
                                    <MudCheckBox @bind-Value="uploadIsCover" Label="Naslovna slika" />
                                }
                            </MudItem>
                            <MudItem xs="12" md="2" Class="d-flex align-center">
                                <MudButton ButtonType="ButtonType.Button"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@(selectedFile is null || isUploading)"
                                           OnClick="UploadFile">
                                    @(isUploading ? "Šalje se..." : "Upload")
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="mt-2">
                            Slike: jpg/png/webp do 5 MB. Dokumenti: PDF do 10 MB.
                        </MudText>
                    </MudPaper>

                    <MudGrid>
                        @foreach (var file in profile.Files)
                        {
                            <MudItem xs="6" md="4">
                                <MudPaper Class="pa-2 d-flex flex-column align-center">
                                    @if (file.FileType == "Image")
                                    {
                                        <img src="@ResolveFileUrl(file.Url)" style="width:100%;height:120px;object-fit:cover;" />
                                        @if (file.IsCoverImage)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-1">Naslovna</MudChip>
                                        }
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Large" />
                                    }
                                    <MudText Typo="Typo.caption" Class="mt-1">@file.OriginalFileName</MudText>
                                    <MudStack Row="true" Spacing="1" Class="mt-1">
                                        <MudLink Href="@ResolveFileUrl(file.Url)" Target="_blank">Preuzmi</MudLink>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => DeleteFile(file.Id))"
                                                       title="Obriši" />
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                        @if (!profile.Files.Any())
                        {
                            <MudText Class="pa-4">Nema dodanih datoteka.</MudText>
                        }
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private EquipmentProfileDto? profile;
    private string? errorMessage;

    private IBrowserFile? selectedFile;
    private string uploadFileType = "Image";
    private bool uploadIsCover;
    private bool isUploading;
    private string? uploadError;

    protected override async Task OnInitializedAsync() => await LoadProfile();

    // Http.BaseAddress pokazuje na Api (npr. https://localhost:7062/).
    // file.Url iz backenda je relativan ("/uploads/equipment/xxx.png"), pa ga ovdje
    // pretvaramo u apsolutan URL - inace <img src> pokusava dohvatiti sliku
    // s adrese App projekta (gdje slika ne postoji), a ne s Api-ja.
    private string ResolveFileUrl(string relativeUrl)
        => new Uri(Http.BaseAddress!, relativeUrl).ToString();

    private async Task LoadProfile()
    {
        profile = await Http.GetFromJsonAsync<EquipmentProfileDto>($"api/equipment/{Id}/profile");
    }

    private async Task OpenAssignDialog()
    {
        errorMessage = null;
        var parameters = new DialogParameters { ["EquipmentId"] = Id };
        var dialog = await DialogService.ShowAsync<AssignEquipmentDialog>("Zaduži opremu", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadProfile();
    }

    private async Task OpenTransferDialog()
    {
        errorMessage = null;
        var parameters = new DialogParameters
        {
            ["EquipmentId"] = Id,
            ["CurrentEmployeeId"] = profile!.Equipment.AssignedToEmployeeId ?? 0
        };
        var dialog = await DialogService.ShowAsync<TransferEquipmentDialog>("Prenesi opremu", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadProfile();
    }

    private async Task ReturnEquipment()
    {
        errorMessage = null;
        var activeAssignment = profile!.AssignmentHistory.FirstOrDefault(a => a.Status == "Aktivno");
        if (activeAssignment is null) return;

        var response = await Http.PostAsJsonAsync("api/assignments/return", new ReturnEquipmentDto
        {
            AssignmentId = activeAssignment.Id
        });

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Oprema vraćena.", Severity.Success);
            await LoadProfile();
        }
        else
        {
            var message = await response.Content.ReadAsStringAsync();
            errorMessage = string.IsNullOrWhiteSpace(message) ? "Greška prilikom povrata." : message;
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        uploadError = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile is null)
            return;

        uploadError = null;
        isUploading = true;

        try
        {
            const long maxAllowedSize = 10 * 1024 * 1024;

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(selectedFile.OpenReadStream(maxAllowedSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);

            content.Add(fileContent, "File", selectedFile.Name);
            content.Add(new StringContent(uploadFileType), "FileType");
            content.Add(new StringContent(uploadIsCover.ToString()), "IsCoverImage");

            var response = await Http.PostAsync($"api/equipment/{Id}/files", content);

            if (response.IsSuccessStatusCode)
            {
                selectedFile = null;
                uploadIsCover = false;
                await LoadProfile();
                Snackbar.Add("Datoteka uploadana.", Severity.Success);
            }
            else
            {
                uploadError = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(uploadError))
                    uploadError = $"Upload nije uspio. Status: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Greška kod uploada: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DeleteFile(int fileId)
    {
        var response = await Http.DeleteAsync($"api/equipment/{Id}/files/{fileId}");

        if (response.IsSuccessStatusCode)
        {
            await LoadProfile();
            Snackbar.Add("Datoteka obrisana.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Greška prilikom brisanja datoteke.", Severity.Error);
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Na skladištu" => Color.Info,
        "Zaduženo" => Color.Success,
        "Na servisu" => Color.Warning,
        "Nedostaje" => Color.Error,
        "Otpisano" => Color.Dark,
        _ => Color.Default
    };
}
