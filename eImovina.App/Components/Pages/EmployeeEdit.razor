@page "/employees/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@using eImovina.Shared.DTOs
@using eImovina.Shared.DTOs.Users
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi zaposlenika</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

<MudForm @ref="form">
    <MudStack Spacing="2">
        <MudTextField @bind-Value="model.FirstName" Label="Ime" Required="true" RequiredError="Ime je obavezno." />
        <MudTextField @bind-Value="model.LastName" Label="Prezime" Required="true" RequiredError="Prezime je obavezno." />
        <MudTextField @bind-Value="model.Email" Label="Email" />

        <MudSelect T="int" Label="Lokacija" @bind-Value="model.LocationId" Variant="Variant.Outlined" Required="true" RequiredError="Odaberi lokaciju.">
            @foreach (var location in locations)
            {
                <MudSelectItem Value="@location.Id">@location.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch @bind-Value="model.IsActive" Label="Aktivan" Color="Color.Primary" />

        <MudButton ButtonType="ButtonType.Button" OnClick="UpdateEmployee" Variant="Variant.Filled" Color="Color.Primary">
            Spremi promjene
        </MudButton>
    </MudStack>
</MudForm>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm form = null!;
    private SaveEmployeeDto model = new();
    private List<LookUpDto> locations = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        locations = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/locations") ?? new();

        var employee = await Http.GetFromJsonAsync<EmployeeDto>($"api/employees/{Id}");
        if (employee is not null)
        {
            model = new SaveEmployeeDto
            {
                FirstName = employee.FirstName,
                LastName = employee.LastName,
                Email = employee.Email,
                LocationId = employee.LocationId,
                IsActive = employee.IsActive
            };
        }
    }

    private async Task UpdateEmployee()
    {
        errorMessage = null;

        await form.ValidateAsync();
        if (!form.IsValid)
            return;

        var response = await Http.PutAsJsonAsync($"api/employees/{Id}", model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/employees");
            return;
        }

        errorMessage = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(errorMessage))
            errorMessage = $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}";
    }
}