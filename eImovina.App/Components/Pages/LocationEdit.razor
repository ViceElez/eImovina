@page "/locations/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin,InventoryManager")]
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@using eImovina.Shared.DTOs
@using eImovina.Shared.DTOs.Locations
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi lokaciju</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

<MudForm @ref="form">
    <MudStack Spacing="2">
        <MudTextField @bind-Value="model.Name" Label="Naziv" Required="true" RequiredError="Naziv je obavezan." />

        <MudSelect T="int" Label="Tip lokacije" @bind-Value="model.LocationTypeId" Variant="Variant.Outlined" Required="true" RequiredError="Odaberi tip lokacije.">
            @foreach (var type in locationTypes)
            {
                <MudSelectItem Value="@type.Id">@type.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="model.Address" Label="Adresa" />

        <MudSwitch @bind-Value="model.IsActive" Label="Aktivna" Color="Color.Primary" />

        <MudButton ButtonType="ButtonType.Button" OnClick="UpdateLocation" Variant="Variant.Filled" Color="Color.Primary">
            Spremi promjene
        </MudButton>
    </MudStack>
</MudForm>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm form = null!;
    private SaveLocationDto model = new();
    private List<LookUpDto> locationTypes = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        locationTypes = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/location-types") ?? new();

        var location = await Http.GetFromJsonAsync<LocationDto>($"api/locations/{Id}");
        if (location is not null)
        {
            model = new SaveLocationDto
            {
                Name = location.Name,
                LocationTypeId = location.LocationTypeId,
                Address = location.Address,
                IsActive = location.IsActive
            };
        }
    }

    private async Task UpdateLocation()
    {
        errorMessage = null;

        await form.ValidateAsync();
        if (!form.IsValid)
            return;

        var response = await Http.PutAsJsonAsync($"api/locations/{Id}", model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/locations");
            return;
        }

        errorMessage = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(errorMessage))
            errorMessage = $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}";
    }
}