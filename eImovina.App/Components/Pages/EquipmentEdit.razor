@page "/equipment/create"
@page "/equipment/edit/{Id:int}"
@rendermode InteractiveServer
@using eImovina.Shared.DTOs
@using eImovina.Shared.DTOs.Equipments
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">@(Id.HasValue ? "Uredi opremu" : "Nova oprema")</MudText>

<MudPaper Class="pa-6" MaxWidth="700px">
    <MudForm @ref="form" Model="model">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="model.InventoryNumber" Label="Inventurni broj" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="model.SerialNumber" Label="Serijski broj" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="model.Name" Label="Naziv" Required="true" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="model.CategoryId" Label="Kategorija" Required="true" Variant="Variant.Outlined">
                    @foreach (var c in categories)
                    {
                        <MudSelectItem T="int" Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="model.StatusId" Label="Status" Required="true" Variant="Variant.Outlined">
                    @foreach (var s in statuses)
                    {
                        <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="model.CurrentLocationId" Label="Lokacija" Required="true" Variant="Variant.Outlined">
                    @foreach (var l in locations)
                    {
                        <MudSelectItem T="int" Value="@l.Id">@l.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="model.Value" Label="Nabavna vrijednost (€)" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="model.PurchaseDate" Label="Datum nabave" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="model.Note" Label="Napomena" Lines="3" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">
                    Spremi
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/equipment"))">
                    Odustani
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public int? Id { get; set; }

    private MudForm form = null!;
    private SaveEquipmentDto model = new();

    private List<LookUpDto> categories = new();
    private List<LookUpDto> statuses = new();
    private List<LookUpDto> locations = new();

    protected override async Task OnInitializedAsync()
    {
        categories = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/equipment-categories") ?? new();
        statuses = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/equipment-statuses") ?? new();
        locations = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/locations") ?? new();

        if (Id.HasValue)
        {
            var existing = await Http.GetFromJsonAsync<EquipmentDto>($"api/equipment/{Id}");
            if (existing is not null)
            {
                model = new SaveEquipmentDto
                {
                    InventoryNumber = existing.InventoryNumber,
                    SerialNumber = existing.SerialNumber,
                    Name = existing.Name,
                    CategoryId = existing.CategoryId,
                    StatusId = existing.StatusId,
                    CurrentLocationId = existing.CurrentLocationId,
                    Value = existing.Value,
                    PurchaseDate = existing.PurchaseDate,
                    Note = existing.Note
                };
            }
        }
    }

    private async Task Save()
    {
        await form.Validate();
        if (!form.IsValid) return;

        HttpResponseMessage response = Id.HasValue
            ? await Http.PutAsJsonAsync($"api/equipment/{Id}", model)
            : await Http.PostAsJsonAsync("api/equipment", model);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Oprema uspješno spremljena.", Severity.Success);
            Navigation.NavigateTo("/equipment");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Greška: {error}", Severity.Error);
        }
    }
}
