@page "/equipment/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin,InventoryManager")]
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@using eImovina.Shared.DTOs
@using eImovina.Shared.DTOs.Equipments
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi opremu</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici dohvaćamo postojeći zapis i spremamo promjene preko PUT zahtjeva.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudForm @ref="form">
    <MudStack Spacing="2">
        <MudTextField @bind-Value="model.InventoryNumber" Label="Inventurni broj" Required="true" />
        <MudTextField @bind-Value="model.SerialNumber" Label="Serijski broj" />
        <MudTextField @bind-Value="model.Name" Label="Naziv" Required="true" />

        <MudSelect T="int"
                   Label="Kategorija"
                   @bind-Value="model.CategoryId"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var category in categoryList)
            {
                <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int"
                   Label="Status"
                   @bind-Value="model.StatusId"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var status in statusList)
            {
                <MudSelectItem Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int"
                   Label="Lokacija"
                   @bind-Value="model.CurrentLocationId"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var location in locationList)
            {
                <MudSelectItem Value="@location.Id">@location.Name</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField @bind-Value="model.Value" Label="Nabavna vrijednost (€)" />
        <MudDatePicker @bind-Date="purchaseDate" Label="Datum nabave" />
        <MudTextField @bind-Value="model.Note" Label="Napomena" Lines="3" />

        <MudButton ButtonType="ButtonType.Button"
                   OnClick="@UpdateEquipment"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Spremi promjene
        </MudButton>
    </MudStack>
</MudForm>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? form;
    private SaveEquipmentDto model = new();
    private DateTime? purchaseDate;
    private string? errorMessage;

    private List<LookUpDto> categoryList = new();
    private List<LookUpDto> statusList = new();
    private List<LookUpDto> locationList = new();

    protected override async Task OnInitializedAsync()
    {
        categoryList = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/equipment-categories") ?? new();
        statusList = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/equipment-statuses") ?? new();
        locationList = await Http.GetFromJsonAsync<List<LookUpDto>>("api/lookups/locations") ?? new();

        var equipment = await Http.GetFromJsonAsync<EquipmentDto>($"api/equipment/{Id}");

        if (equipment is not null)
        {
            model = new SaveEquipmentDto
            {
                InventoryNumber = equipment.InventoryNumber,
                SerialNumber = equipment.SerialNumber,
                Name = equipment.Name,
                CategoryId = equipment.CategoryId,
                StatusId = equipment.StatusId,
                CurrentLocationId = equipment.CurrentLocationId,
                Value = equipment.Value,
                PurchaseDate = equipment.PurchaseDate,
                Note = equipment.Note
            };

            purchaseDate = equipment.PurchaseDate;
        }
    }

    private async Task UpdateEquipment()
    {
        if (form is not null)
        {
            await form.ValidateAsync();

            if (!form.IsValid)
                return;
        }

        errorMessage = null;
        model.PurchaseDate = purchaseDate;

        var response = await Http.PutAsJsonAsync($"api/equipment/{Id}", model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/equipment");
            return;
        }

        var message = await response.Content.ReadAsStringAsync();
        errorMessage = string.IsNullOrWhiteSpace(message)
            ? $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}"
            : message;
    }
}
