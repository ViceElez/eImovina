@inherits LayoutComponentBase
@using eImovina.App.Auth
@using eImovina.App.Components.Layout
@using eImovina.App.Components.Pages
@inject AuthTokenProvider TokenProvider

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6">e-Imovina</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">Sustav za upravljanje e-Imovinom</MudText>
        <LogoutButton />
    </MudAppBar>

    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-6 mt-16">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    protected override async Task OnInitializedAsync()
    {
        await TokenProvider.RestoreSessionHeaderAsync();
    }
}
